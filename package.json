{
  "name": "pixxel360",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3333 --experimental-https",
    "prebuild": "npm run db:generate",
    "build": "next build",
    "start": "next start -p 3333",
    "db:generate": "prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "lucide-react": "^1.40.0",
    "mysql2": "^3.24.3",
    "next": "^15.5.27",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
